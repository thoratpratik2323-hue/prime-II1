# Prime AI - Environment Configuration

# 1. Google Gemini API Key (Recommended - Get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Or Groq API Key (Ultra-fast - Get free at https://console.groq.com/)
GROQ_API_KEY=

# 3. Or OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Preferred AI Provider: auto, gemini, groq, or openai
AI_PROVIDER=auto

# Preferred Model Name (leave blank for recommended defaults)
# Gemini: gemini-2.0-flash
# Groq: llama-3.3-70b-versatile
# OpenAI: gpt-4o-mini
AI_MODEL=

# Voice Settings
VOICE_OUTPUT=true
VOICE_RATE=185
VOICE_VOLUME=1.0
